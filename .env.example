# OpenRouter API Key (Get a free key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary OpenRouter Model (Free tier models: google/gemini-2.0-flash-lite-001, meta-llama/llama-3.3-70b-instruct:free, google/gemma-2-9b-it:free)
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001

# Fallback Models (comma-separated list if the primary model fails or is rate-limited)
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-2-9b-it:free,mistralai/mistral-7b-instruct:free

# Request timeout in seconds
OPENROUTER_TIMEOUT=45

# Maximum retry attempts on 429/5xx errors
OPENROUTER_MAX_RETRIES=3
